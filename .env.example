# PromptOps Console - copy to .env and adjust. Never commit real secrets.
PROMPTOPS_HOST=127.0.0.1
PROMPTOPS_PORT=8787
PROMPTOPS_DATA_DIR=./data
# PROMPTOPS_DATABASE_URL=sqlite+aiosqlite:///./data/promptops.db
# PROMPTOPS_SECRET_KEY=
PROMPTOPS_AUTO_MIGRATE=true
PROMPTOPS_UTC_OFFSET=+08:00
PROMPTOPS_MAX_CONCURRENT_RUNS=2
PROMPTOPS_SCHEDULER_TICK_SECONDS=1
PROMPTOPS_MISSED_GRACE_SECONDS=300
PROMPTOPS_CANCEL_CONFIRM_SECONDS=30
PROMPTOPS_RUN_HEARTBEAT_SECONDS=10
PROMPTOPS_STALE_RUN_SECONDS=300
PROMPTOPS_SSE_STALE_SECONDS=10
PROMPTOPS_LOG_LEVEL=INFO
PROMPTOPS_LOG_DIR=./data/logs
PROMPTOPS_FRONTEND_DIST=./frontend/dist
PROMPTOPS_CORS_ORIGINS=

# Optional first-run seed (only used when the database has no Endpoint)
PROMPTOPS_DEFAULT_ENDPOINT_NAME=
PROMPTOPS_DEFAULT_ENDPOINT_URL=
PROMPTOPS_DEFAULT_ENDPOINT_USERNAME=opencode
PROMPTOPS_DEFAULT_ENDPOINT_PASSWORD=
